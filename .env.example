# Server-only; never prefix database or Gemini credentials with NEXT_PUBLIC_.
DATABASE_URL=postgresql://pain_journal:pain_journal@127.0.0.1:5432/pain_journal

# Optional canonical origin behind a reverse proxy. Otherwise use the request origin.
# APP_ORIGIN=http://localhost:3000

# Independent of the database. Set both values to enable the server-side Gemini report action.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_TIMEOUT_MS=15000
